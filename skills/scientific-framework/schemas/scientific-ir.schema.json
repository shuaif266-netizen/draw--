{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "scientific-ir",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "scientific-framework/ir/v1"
    },
    "artifact_status": {
      "enum": [
        "draft",
        "reviewed",
        "approved"
      ]
    },
    "project": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "title_status": {
          "enum": [
            "missing",
            "provisional",
            "provided"
          ]
        },
        "working_title": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "source_id": {
                "type": "string",
                "minLength": 1
              },
              "format": {
                "enum": [
                  "txt",
                  "md",
                  "docx"
                ]
              },
              "file_alias": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "source_id",
              "format",
              "file_alias",
              "sha256"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "diagram_purpose": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "title",
        "title_status",
        "working_title",
        "source",
        "diagram_purpose"
      ],
      "additionalProperties": false
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "short_label": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "background",
              "research_gap",
              "research_problem",
              "scientific_question",
              "hypothesis",
              "overall_objective",
              "sub_objective",
              "research_content",
              "work_package",
              "research_task",
              "progress",
              "research_object",
              "material",
              "data",
              "method",
              "comparison",
              "condition",
              "evidence",
              "mechanism",
              "process",
              "validation",
              "feedback",
              "intervention",
              "cultivation",
              "output",
              "innovation",
              "limitation"
            ]
          },
          "level": {
            "type": "integer",
            "minimum": 0
          },
          "group": {
            "type": "string",
            "minLength": 1
          },
          "source_text": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "source_location": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "source_id": {
                  "type": "string",
                  "minLength": 1
                },
                "segment_id": {
                  "type": "string",
                  "minLength": 1
                },
                "line_start": {
                  "type": "integer",
                  "minimum": 1
                },
                "line_end": {
                  "type": "integer",
                  "minimum": 1
                },
                "heading_path": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 0
                },
                "body_paragraph_index": {
                  "type": "integer",
                  "minimum": 1
                },
                "table_index": {
                  "type": "integer",
                  "minimum": 1
                },
                "row_index": {
                  "type": "integer",
                  "minimum": 1
                },
                "cell_index": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "source_id",
                "segment_id"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "needs_review": {
            "type": "boolean"
          },
          "statement_status": {
            "enum": [
              "definition",
              "background_claim",
              "planned",
              "hypothesized",
              "expected",
              "reported"
            ]
          },
          "extraction_status": {
            "enum": [
              "explicit",
              "normalized",
              "inferred",
              "missing"
            ]
          },
          "core": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "label",
          "short_label",
          "type",
          "level",
          "group",
          "source_text",
          "source_location",
          "confidence",
          "needs_review",
          "statement_status",
          "extraction_status",
          "core"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "relation": {
            "enum": [
              "contains",
              "leads_to",
              "enables",
              "depends_on",
              "influences",
              "compares_with",
              "contrasts_with",
              "validates",
              "evidence_for",
              "transforms_to",
              "feeds_back_to",
              "temporal_before",
              "parallel_with",
              "supports",
              "applies_to",
              "addresses",
              "uses",
              "produces",
              "causes"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "source_id": {
                  "type": "string",
                  "minLength": 1
                },
                "segment_id": {
                  "type": "string",
                  "minLength": 1
                },
                "quote": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "source_id",
                "segment_id",
                "quote"
              ],
              "additionalProperties": false
            },
            "minItems": 0
          },
          "source_location": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "source_id": {
                  "type": "string",
                  "minLength": 1
                },
                "segment_id": {
                  "type": "string",
                  "minLength": 1
                },
                "line_start": {
                  "type": "integer",
                  "minimum": 1
                },
                "line_end": {
                  "type": "integer",
                  "minimum": 1
                },
                "heading_path": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 0
                },
                "body_paragraph_index": {
                  "type": "integer",
                  "minimum": 1
                },
                "table_index": {
                  "type": "integer",
                  "minimum": 1
                },
                "row_index": {
                  "type": "integer",
                  "minimum": 1
                },
                "cell_index": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "source_id",
                "segment_id"
              ],
              "additionalProperties": false
            },
            "minItems": 0
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "needs_review": {
            "type": "boolean"
          },
          "statement_status": {
            "enum": [
              "definition",
              "background_claim",
              "planned",
              "hypothesized",
              "expected",
              "reported"
            ]
          },
          "interpretation_note": {
            "type": "string"
          },
          "core": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "source",
          "target",
          "relation",
          "evidence",
          "source_location",
          "confidence",
          "needs_review",
          "statement_status",
          "interpretation_note",
          "core"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "review_items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "subject_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "issue": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "enum": [
              "blocker",
              "warning"
            ]
          },
          "needs_review": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "subject_ids",
          "issue",
          "severity",
          "needs_review"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "agent_review": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "pending",
            "completed"
          ]
        },
        "reviewer": {
          "type": "string",
          "minLength": 1
        },
        "source_snapshot_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "subject_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              "issue": {
                "type": "string",
                "minLength": 1
              },
              "severity": {
                "enum": [
                  "blocker",
                  "warning"
                ]
              },
              "needs_review": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "subject_ids",
              "issue",
              "severity",
              "needs_review"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        },
        "summary": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "status",
        "reviewer",
        "source_snapshot_sha256",
        "issues",
        "summary"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "artifact_status",
    "project",
    "nodes",
    "relations",
    "review_items",
    "agent_review"
  ],
  "additionalProperties": false
}
